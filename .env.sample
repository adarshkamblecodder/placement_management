# ─── Application ──────────────────────────────────────────────────────────────
SECRET_KEY=generate_a_random_secure_key_here
DEBUG=False
NODE_ENV=production
ALLOWED_HOSTS=yourdomain.com

# ─── PostgreSQL Database ───────────────────────────────────────────────────────
# Option 1 — Single connection URL (used by Render, Heroku, Railway, etc.)
# Set this and leave the individual DB_* vars blank.
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Option 2 — Individual variables (used for local development)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=placement_db
DB_USER=placement_user
DB_PASSWORD=your_secure_password

# ─── College Branding (Multi-College White-Label) ──────────────────────────────
COLLEGE_NAME="Your College Name"
COLLEGE_LOGO="/static/logo.png"
DOMAIN_NAME=yourdomain.com
THEME_COLOR="#4f46e5"
THEME_COLOR_DARK="#0ea5e9"
FAVICON_PATH="/static/favicon.ico"
SHOW_POWERED_BY=true
POWERED_BY_NAME="Placement Portal"

# ─── SMTP / Mail ───────────────────────────────────────────────────────────────
# Required for student login credential emails and placement notifications.
# Gmail: enable 2-Step Verification → create an App Password (16 chars) → paste below.
# SMTP_PASS must be the App Password, NOT your normal Gmail login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_real_gmail@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
MAIL_FROM=your_real_gmail@gmail.com
